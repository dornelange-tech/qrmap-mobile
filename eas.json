{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "apk": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "ios": {
        "image": "latest",
        "prebuildCommand": "cd ios && pod install && sed -i \"\" \"s/#  define FMT_USE_CONSTEVAL 1/#  define FMT_USE_CONSTEVAL 0/g\" Pods/fmt/include/fmt/base.h"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {}
  }
}
